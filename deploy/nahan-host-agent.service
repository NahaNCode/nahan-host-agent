[Unit]
Description=NahaN Host Agent
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/nahan-host-agent --config /etc/nahan-host-agent/config.json
Restart=on-failure
RestartSec=10
User=root
RuntimeDirectory=nahan-host-placement
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/nahan-host-agent /proc/sys/net/ipv4/conf /run
ReadOnlyPaths=/proc/sys /sys
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
